# ── Maritime Middleware (frontend) — environment configuration ───────────────
# Copy this to .env and fill in your values (react-scripts / CRA loads .env
# automatically; Electron's main process reads process.env directly).

# Backend location, read by electron/main.js (plain Node — no REACT_APP_
# prefix needed since this never goes through the CRA/webpack build).
# main.js exposes it to the renderer over IPC (window.electronAPI.getBackendUrl()),
# which is what src/lib/api.js actually uses in normal Electron usage — so this
# is the one place that needs changing to point the whole app at a non-default
# backend (e.g. a staging server instead of a dev laptop).
BACKEND_URL=http://127.0.0.1:5000

# Fallback backend location used ONLY by src/lib/api.js when there's no
# Electron preload context at all — e.g. running `npm run react` and opening
# http://localhost:3000 directly in a browser for pure frontend dev, where
# window.electronAPI is undefined. Ignored when running inside Electron
# (BACKEND_URL above wins via the IPC bridge). Must keep the REACT_APP_
# prefix — CRA only inlines process.env.* vars with that prefix into the
# built bundle.
REACT_APP_BACKEND_URL=http://127.0.0.1:5000
