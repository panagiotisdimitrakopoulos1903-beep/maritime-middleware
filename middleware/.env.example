# ── Maritime Middleware — environment configuration ───────────────────────────
# Copy this to .env and fill in your values.

# Application
APP_NAME=Maritime Middleware
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://middleware:middleware@localhost:5432/maritime_middleware

# Anthropic API — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LLM settings
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
PARSER_CONFIDENCE_THRESHOLD=0.75

# Signal Ocean API — get from apis.signalocean.com
SIGNAL_OCEAN_API_KEY=...
SIGNAL_CACHE_REFRESH_MINUTES=5
SIGNAL_LAYCAN_WINDOW_DAYS=30
SIGNAL_MAX_RESULTS=50

# IMAP ingestion poller (IMAP_MODE itself is read directly from the
# environment, not pydantic-settings — see mcp/imap_server.py)
IMAP_POLL_INTERVAL_MINUTES=2
IMAP_POLL_BATCH_SIZE=20

# Milter (mail interception)
MILTER_SOCKET=inet:9900@localhost
MILTER_NAME=MaritimeMilter

# Matching — weights must sum to 1.0
MATCH_TOP_N=5
WEIGHT_VESSEL_SIZE=0.35
WEIGHT_GEOGRAPHY=0.30
WEIGHT_DATE_OVERLAP=0.20
WEIGHT_CARGO_TYPE=0.15
