# ── Maritime Middleware — environment configuration ───────────────────────────
# Copy this to .env and fill in your values.

# Application
APP_NAME=Maritime Middleware
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://middleware:middleware@localhost:5432/maritime_middleware

# Anthropic API — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LLM settings
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
PARSER_CONFIDENCE_THRESHOLD=0.75

# Signal Ocean API — get from apis.signalocean.com
# (SIGNAL_MODE itself is read directly from the environment, not
# pydantic-settings — see mcp/signal_server.py)
SIGNAL_OCEAN_API_KEY=...
SIGNAL_CACHE_REFRESH_MINUTES=5
SIGNAL_LAYCAN_WINDOW_DAYS=30
SIGNAL_MAX_RESULTS=50

# IMAP ingestion poller (IMAP_MODE itself is read directly from the
# environment, not pydantic-settings — see mcp/imap_server.py)
IMAP_POLL_INTERVAL_MINUTES=2
IMAP_POLL_BATCH_SIZE=20

# IMAP mailbox credentials — only required when IMAP_MODE=live
# (mcp/imap_client.py). Leave blank for IMAP_MODE=mock (the default).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# SMTP mailbox credentials — the broker's real mailbox, used by
# mail/smtp_client.py to send outbound replies via POST /internal/send
# (ADR 0004, Decision #5). Independent of the IMAP_* credentials above
# (different hostnames on the same provider are common), even though in
# practice they'll usually be the same mailbox. Leave blank in local dev
# where no send capability is needed — POST /internal/send returns a clean
# 503 rather than crashing when these are unset. No mock/live toggle for
# this path (unlike IMAP_MODE/SIGNAL_MODE) — sends are either configured
# or not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true

# Broker display identity — prefills the "From" field when composing a
# reply in the Electron panel (GET /config). Distinct from IMAP_USER/
# SMTP_USER (the mailbox's own login identity) because the display name/
# reply-to a counterparty sees may differ from the account credentials
# (e.g. a shared desk mailbox login used by multiple individual brokers).
# Leave blank in local dev — the compose form's From field just starts
# empty and stays manually-editable, same as today, not a new failure mode.
BROKER_NAME=
BROKER_EMAIL=

# Matching — weights must sum to 1.0
MATCH_TOP_N=5
WEIGHT_VESSEL_SIZE=0.35
WEIGHT_GEOGRAPHY=0.30
WEIGHT_DATE_OVERLAP=0.20
WEIGHT_CARGO_TYPE=0.15
